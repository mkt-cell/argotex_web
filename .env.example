# Lead-form storage (Supabase). Set these in the Vercel project's
# Environment Variables. The service-role key is server-only — it is read by
# the /api/contact and /api/catalog-download route handlers and must NEVER be
# exposed to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: forward each submission to an automation pipeline (n8n, Zapier, etc.).
# Leave blank to disable — submissions are still stored in Supabase.
N8N_WEBHOOK_URL=
